# Build output
out/
dist/
release/

# Dependencies
node_modules/
.pnpm-store/

# Editor / OS noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# Local test artifacts
coverage/
.vitest/
*.tsbuildinfo

# Never commit real documents — this is a note-taking app, and your notes are yours.
*.local.md
# Local run logs
out.txt
err.txt
electron.log

# Version history. Valence writes this beside each note on every save, so opening someone's
# notes folder as a workspace fills their repository with snapshot history.
.valence/


# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
