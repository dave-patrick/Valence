  "components": [
    {
      "name": "Document Tab",
      "kind": "nav",
      "refersTo": "tab-active",
      "description": "Document Tab using the live resolved appearance variables.",
      "html": "<button class=\"ds-tab\" aria-selected=\"true\">Draft.md</button>",
      "css": ".ds-tab{border:0;border-radius:7px;background:var(--bg-active);color:var(--text);font-family:var(--font-body);font-size:calc(12.5px * var(--ui-scale,1));height:32px;padding:0 4px 0 12px}.ds-tab:hover{background:var(--bg-hover)}.ds-tab:focus-visible{outline:2px solid var(--line-focus)}"
    },
    {
      "name": "Appearance Selector",
      "kind": "input",
      "refersTo": "appearance-select",
      "description": "Appearance Selector using the live resolved appearance variables.",
      "html": "<label class=\"ds-label\">Theme <select class=\"ds-select\"><option>Quantos Dark</option><option>Quantos Light</option></select></label>",
      "css": ".ds-label{display:flex;align-items:center;justify-content:space-between;gap:16px;color:var(--text-soft);font-family:var(--font-body)}.ds-select{height:32px;padding:0 8px;max-width:58%;min-width:150px;border:1px solid var(--line);border-radius:6px;background:var(--bg-input);color:var(--text);font:inherit}.ds-select:hover{border-color:var(--line-strong)}.ds-select:focus-visible{outline:2px solid var(--line-focus)}"
    },
    {
      "name": "Editor Card",
      "kind": "card",
      "refersTo": "editor-card",
      "description": "Editor Card using the live resolved appearance variables.",
      "html": "<article class=\"ds-editor\">A place to write.</article>",
      "css": ".ds-editor{border:1px solid var(--line);border-radius:12px;background:var(--editor-bg);color:var(--text);font-family:var(--font-editor);font-size:var(--editor-size);padding:2rem;overflow:hidden}"
    },
    {
      "name": "Automatic Color Reset",
      "kind": "button",
      "description": "Automatic Color Reset using the live resolved appearance variables.",
      "html": "<button class=\"ds-auto\">Auto</button>",
      "css": ".ds-auto{font-family:var(--font-body);font-size:11px;color:var(--accent);padding:4px;border:0;border-radius:4px;background:transparent}.ds-auto:hover:not(:disabled){background:var(--bg-hover)}.ds-auto:focus-visible{outline:2px solid var(--line-focus)}.ds-auto:disabled{color:var(--text-muted);cursor:default}"
    },
    {
      "name": "Appearance Preset",
      "kind": "button",
      "description": "Appearance Preset using the live resolved appearance variables.",
      "html": "<button class=\"ds-preset\"><span class=\"ds-swatch\"></span><span>Quantos Dark</span></button>",
      "css": ".ds-preset{display:flex;flex-direction:column;align-items:center;gap:6px;width:96px;padding:10px 6px;border:1px solid var(--line);border-radius:var(--radius);background:var(--bg-panel);color:var(--text-soft);font-family:var(--font-body);cursor:pointer;transition:border-color .12s var(--ease-out),box-shadow .12s var(--ease-out)}.ds-swatch{width:64px;height:32px;border-radius:var(--radius-sm);background:var(--bg)}.ds-preset:hover{border-color:var(--accent)}.ds-preset:focus-visible{outline:2px solid var(--line-focus)}.ds-preset:active{box-shadow:0 0 0 2px var(--accent)}"
    }
  ],
  "narrative": {
    "northStar": "The calm card workspace",
    "overview": "The document leads inside a quiet, inset workspace inherited from Quantos. Separate header, navigation, editor and status surfaces make the application readable without competing with the writing. Controls stay compact; the editor receives the generous reading measure.\n\nThe palette, typography and spacing are user-controlled. Defaults define the family resemblance, while live appearance settings preserve that structure across custom colors, installed fonts and legacy paired themes.",
    "keyCharacteristics": [
      "Inset, softly rounded panes on a neutral canvas.",
      "Restrained blue interaction cues and hierarchical text.",
      "Independent interface, heading, editor and monospace font roles.",
      "Local, persistent appearance customization."
    ],
    "rules": [
      {
        "name": "The Resolved Palette Rule",
        "body": "Consume semantic CSS variables. A custom background determines light/dark derivation, and explicit element overrides remain authoritative. Automatic swatches must show the actual resolved palette.",
        "section": "colors"
      },
      {
        "name": "The Four Roles Rule",
        "body": "Keep UI, heading, editor and code fonts independently configurable; do not hardcode a font into new application controls.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do use resolved semantic colors and the four font roles.",
      "Do preserve pane resizing, outline docking, editor modes and keyboard commands.",
      "Do test dark, light, narrow and customized appearances.",
      "Do keep automatic swatches consistent with the actual resolved palette."
    ],
    "donts": [
      "Don't replace editable appearance roles with hardcoded default colors.",
      "Don't use decorative shadows on resting workspace panes.",
      "Don't let reading width force split panes wider than their container.",
      "Don't introduce shipping raster assets without recording provenance."
    ]
  }
}
