{
  "name": "valence",
  "version": "0.1.0",
  "private": true,
  "description": "Valence - a local-first Markdown editor. Typora seamless reading, MarkText editor depth, modernised.",
  "author": "Dave Patrick <dave-patrick@users.noreply.github.com>",
  "main": "./out/main/index.js",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.renderer.config.ts",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "build:win": "electron-vite build && electron-builder --win --x64 --publish never",
    "build:mac": "electron-vite build && electron-builder --mac --publish never",
    "build:linux": "electron-vite build && electron-builder --linux --publish never",
    "verify:package": "node scripts/verify-package.mjs",
    "stage": "node scripts/stage-release.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-mathematics": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "electron-updater": "^6.8.9",
    "katex": "^0.19.0",
    "markdown-it": "^15.0.2",
    "mermaid": "^12.2.0",
    "shiki": "^4.5.0",
    "yaml": "^2.9.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/katex": "^0.16.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "dev.valence.editor",
    "productName": "Valence",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!**/node_modules/**/*"
    ],
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "dave-patrick",
        "repo": "Valence",
        "releaseType": "release"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "resources/icon.png"
    },
    "win": {
      "target": [
        "zip"
      ],
      "icon": "resources/icon.png",
      "fileAssociations": [
        {
          "ext": "md",
          "name": "Markdown",
          "description": "Markdown document",
          "icon": "resources/icon.png",
          "role": "Editor"
        },
        {
          "ext": "markdown",
          "name": "Markdown",
          "description": "Markdown document",
          "icon": "resources/icon.png",
          "role": "Editor"
        },
        {
          "ext": "mdown",
          "name": "Markdown",
          "description": "Markdown document",
          "icon": "resources/icon.png",
          "role": "Editor"
        },
        {
          "ext": "mkd",
          "name": "Markdown",
          "description": "Markdown document",
          "icon": "resources/icon.png",
          "role": "Editor"
        },
        {
          "ext": "txt",
          "name": "Text",
          "description": "Plain text file",
          "icon": "resources/icon.png",
          "role": "Editor"
        }
      ]
    },
    "linux": {
      "category": "Office",
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/valence.git"
  },
  "homepage": "https://github.com/OWNER/valence#readme",
  "bugs": {
    "url": "https://github.com/OWNER/valence/issues"
  },
  "keywords": [
    "markdown",
    "editor",
    "wysiwyg",
    "local-first",
    "prosemirror",
    "typography"
  ],
  "license": "MIT"
}
